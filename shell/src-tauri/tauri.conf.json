{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AIPunch",
  "mainBinaryName": "AIPunch",
  "version": "0.2.6",
  "identifier": "com.aipunch.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "AIPunch",
        "width": 1180,
        "height": 740,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/**/*"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU4QjdFMEUwRkNDODg3OTEKUldTUmg4ajg0T0MzV0tTTTExN0Y2cWt5MTFHbVVubFMxS2ZNaHRRZkpSSnBTSDNRdFdDWHAwSU0K",
      "endpoints": [
        "https://github.com/clzwqoii/aipunch/releases/latest/download/latest.json"
      ]
    }
  }
}
