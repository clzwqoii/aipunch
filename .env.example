# 复制为 .env 并填入值（.env 已在 .gitignore，切勿提交）：
#   cp .env.example .env
# 已有同名环境变量（shell/CI）优先，.env 不会覆盖它

# WorkBuddy 长期凭证（npm run login 获取）
WORKBUDDY_REFRESH_TOKEN=
# TRAE 凭证
TRAE_REFRESH_TOKEN=
TRAE_DEVICE_ID=
TRAE_USER_ID=

# QODER 服务集成个人令牌, 有效期一年
QODER_PAT=

# CODEARTS 授权
CODEARTS_DPOP_KEY=
CODEARTS_CODE_VERIFIER=