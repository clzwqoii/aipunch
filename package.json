{
  "name": "aipunch",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "login": "tsx runners/login.ts",
    "trae-extract": "tsx runners/trae-extract.ts",
    "trae-login": "tsx runners/trae-login.ts",
    "qoder-login": "tsx runners/qoder-login.ts",
    "autoclaw-login": "tsx runners/autoclaw-login.ts",
    "autoclaw-intl-login": "tsx runners/autoclaw-intl-login.ts",
    "codearts-login": "tsx runners/codearts-login.ts",
    "raccoon-extract": "tsx runners/raccoon-extract.ts",
    "checkin": "tsx runners/cli.ts",
    "ci-checkin": "tsx runners/ci-checkin.ts",
    "ci-sync": "tsx runners/ci-sync.ts",
    "cf-deploy": "tsx runners/cf-deploy.ts",
    "netcheck": "tsx runners/netcheck.ts",
    "dry-run": "tsx runners/cli.ts --dry-run",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test core/*.test.ts providers/*.test.ts runners/*.test.ts cloudflare/*.test.ts",
    "shell": "npm run build:engine && npm --prefix shell run tauri dev",
    "shell:build": "npm run build:engine && npm --prefix shell run tauri build",
    "release": "bash tool/release.sh",
    "build:engine": "node tool/build-engine.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.6.0"
  },
  "version": "0.2.7"
}
